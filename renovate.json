{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "constraints": {
    "pnpm": "10.34.7"
  },
  "packageRules": [
    {
      "description": "Group Cargo patch updates without mixing in breaking minor updates",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["patch"],
      "groupName": "Cargo patch dependencies"
    },
    {
      "description": "Group npm patch updates separately from Cargo updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch"],
      "groupName": "npm patch dependencies"
    }
  ]
}
