  "db_name": "PostgreSQL",
  "query": "\n        SELECT k.id, k.user_id, k.purpose, u.display_name, u.username\n        FROM api_keys k\n        JOIN users u ON u.id = k.user_id\n        WHERE k.secret_hash = $1 AND k.is_deleted = false\n        ",
