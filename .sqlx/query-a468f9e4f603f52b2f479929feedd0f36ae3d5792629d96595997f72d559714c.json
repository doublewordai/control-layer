{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT k.id, k.user_id, k.purpose, COALESCE(u.display_name, u.username) AS account_name\n        FROM api_keys k\n        JOIN users u ON u.id = k.user_id\n        WHERE k.secret = $1 AND k.is_deleted = false\n        ",
