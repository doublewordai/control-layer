{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT ak.user_id, ak.id as api_key_id, ak.purpose,\n                   CASE WHEN root.spend_limit IS NOT NULL THEN root.id END AS \"cap_scope_root?\"\n            FROM api_keys ak\n            JOIN api_keys root ON root.id = COALESCE(ak.parent_api_key_id, ak.id)\n            WHERE ak.id = ANY($1)\n            ",
