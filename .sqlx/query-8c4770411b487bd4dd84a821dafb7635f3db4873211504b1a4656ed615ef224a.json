  "query": "\n        SELECT ak.secret, ak.user_id, ak.purpose, u.zero_data_retention, u.disabled_modalities, u.toleration_preset\n        FROM api_keys ak\n        JOIN users u ON u.id = ak.user_id\n        WHERE NOT ak.is_deleted\n        ",
