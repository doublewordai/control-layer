{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelDocument",
  "type": "object",
  "properties": {
    "model": {
      "description": "Canonical Hugging Face model identifier.",
      "type": "string"
    },
    "backend": {
      "description": "Reserved for the inference deployment automation. Ignored by dwctl.",
      "default": null
    },
    "clay": {
      "description": "Control-layer model graph. Omit for a backend-only document.",
      "anyOf": [
        {
          "$ref": "#/$defs/ClayModel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "additionalProperties": false,
  "required": [
    "model"
  ],
  "$defs": {
    "ClayModel": {
      "type": "object",
      "properties": {
        "alias": {
          "type": "string"
        },
        "model_name": {
          "description": "Defaults to the document's top-level `model` value.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "capabilities": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null
        },
        "settings": {
          "$ref": "#/$defs/ModelSettings",
          "default": {
            "requests_per_second": null,
            "burst_size": null,
            "capacity": null,
            "realtime_inflight_limit": null,
            "batch_capacity": null,
            "throughput": null,
            "sanitize_responses": false,
            "trusted": false,
            "allowed_batch_completion_windows": null,
            "metadata": {},
            "reasoning_translation_overrides": null
          }
        },
        "deployments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PhysicalDeployment"
          },
          "default": []
        },
        "routing": {
          "$ref": "#/$defs/Routing",
          "default": {
            "strategy": "weighted_random",
            "fallback": {
              "enabled": true,
              "on_rate_limit": true,
              "on_status": [
                429,
                499,
                500,
                502,
                503,
                504
              ],
              "with_replacement": false,
              "max_attempts": null,
              "backoff": null,
              "max_total_backoff_ms": null
            },
            "pools": {}
          }
        },
        "tariffs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Tariff"
          },
          "default": []
        },
        "cache_tariff": {
          "anyOf": [
            {
              "$ref": "#/$defs/CacheTariff"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "access_groups": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "traffic_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TrafficRule"
          },
          "default": []
        },
        "routing_mode": {
          "description": "How the model routes: `legacy` (its composite routing) or\n`class_routes` (each class in `class_routes` to its own upstream:\n`alias` to `standard`, `alias:<class>` to that class).",
          "$ref": "#/$defs/RoutingMode",
          "default": "legacy"
        },
        "serving_classes": {
          "description": "Retired. Accepted only when empty, so existing catalog files still\nload; remove it.",
          "type": "object",
          "additionalProperties": true,
          "maxProperties": 0
        },
        "class_routes": {
          "description": "Class destinations and prices. Declaring them alone changes nothing;\n`routing_mode: class_routes` activates them. `standard` is required.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ClassRoute"
          },
          "default": {},
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "alias"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "routing_mode": {
                "const": "class_routes"
              }
            },
            "required": [
              "routing_mode"
            ]
          },
          "then": {
            "properties": {
              "class_routes": {
                "required": [
                  "standard"
                ]
              },
              "traffic_rules": {
                "items": {
                  "not": {
                    "properties": {
                      "action": {
                        "const": "redirect"
                      }
                    },
                    "required": [
                      "action"
                    ]
                  }
                }
              }
            },
            "required": [
              "class_routes"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "class_routes": {
                "minProperties": 1
              }
            },
            "required": [
              "class_routes"
            ]
          },
          "then": {
            "properties": {
              "class_routes": {
                "required": [
                  "standard"
                ]
              }
            }
          }
        }
      ]
    },
    "ModelKind": {
      "type": "string",
      "enum": [
        "chat",
        "embeddings",
        "reranker"
      ]
    },
    "ModelSettings": {
      "type": "object",
      "properties": {
        "requests_per_second": {
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null,
          "deprecated": true
        },
        "burst_size": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32",
          "default": null,
          "deprecated": true
        },
        "capacity": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32",
          "default": null,
          "deprecated": true
        },
        "realtime_inflight_limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32",
          "default": null
        },
        "batch_capacity": {
          "description": "Dual-purpose batch concurrency. It seeds fusillade's **starting**\nper-daemon concurrency for the model (adaptive concurrency may grow past\nit), and, once `limits.batch_inflight.enforce` is on, it is also the\n**global** onwards cap on batch requests in flight on the alias. A\npositive value is used directly; when omitted, the onwards cap falls back\nto `limits.batch_inflight.default_capacity` (default 200) while\nfusillade's starting concurrency falls back to\n`background_services.batch_daemon.default_model_concurrency`. Raise it to\nthe intended global ceiling before enabling enforcement. The cap is\nshared by file batches, flex and background requests.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int32",
          "default": null
        },
        "throughput": {
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "sanitize_responses": {
          "type": "boolean",
          "default": false
        },
        "trusted": {
          "type": "boolean",
          "default": false
        },
        "allowed_batch_completion_windows": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null
        },
        "metadata": {
          "default": {}
        },
        "reasoning_translation_overrides": {
          "default": null
        }
      },
      "additionalProperties": false
    },
    "PhysicalDeployment": {
      "type": "object",
      "properties": {
        "alias": {
          "type": "string"
        },
        "model_name": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "capabilities": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null
        },
        "settings": {
          "$ref": "#/$defs/ModelSettings",
          "default": {
            "requests_per_second": null,
            "burst_size": null,
            "capacity": null,
            "realtime_inflight_limit": null,
            "batch_capacity": null,
            "throughput": null,
            "sanitize_responses": false,
            "trusted": false,
            "allowed_batch_completion_windows": null,
            "metadata": {},
            "reasoning_translation_overrides": null
          }
        },
        "provider_pricing": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderPricing"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "alias",
        "model_name",
        "endpoint"
      ]
    },
    "ProviderPricing": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "input_per_million_tokens": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "output_per_million_tokens": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "mode": {
              "type": "string",
              "const": "per_token"
            }
          },
          "additionalProperties": false,
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "rate": {
              "type": "string"
            },
            "input_token_cost_ratio": {
              "type": "string"
            },
            "mode": {
              "type": "string",
              "const": "hourly"
            }
          },
          "additionalProperties": false,
          "required": [
            "mode",
            "rate",
            "input_token_cost_ratio"
          ]
        }
      ]
    },
    "Routing": {
      "type": "object",
      "properties": {
        "strategy": {
          "$ref": "#/$defs/RoutingStrategy",
          "default": "weighted_random"
        },
        "fallback": {
          "$ref": "#/$defs/Fallback",
          "default": {
            "enabled": true,
            "on_rate_limit": true,
            "on_status": [
              429,
              499,
              500,
              502,
              503,
              504
            ],
            "with_replacement": false,
            "max_attempts": null,
            "backoff": null,
            "max_total_backoff_ms": null
          }
        },
        "pools": {
          "description": "Named component pools. Supported names are `default` and `completions`.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Component"
            }
          },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "RoutingStrategy": {
      "type": "string",
      "enum": [
        "weighted_random",
        "priority"
      ]
    },
    "Fallback": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "on_rate_limit": {
          "type": "boolean",
          "default": true
        },
        "on_status": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int32"
          },
          "default": [
            429,
            499,
            500,
            502,
            503,
            504
          ]
        },
        "realtime_on_status": {
          "description": "Extra statuses that fail over realtime traffic only. Omit to keep the\nvalue already stored for the model.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "int32"
          }
        },
        "affinity": {
          "description": "Conversation affinity (priority strategy only). Omit to keep the value\nalready stored for the model. `target_conversations` must match what\nthe preferred member can serve concurrently.",
          "anyOf": [
            {
              "$ref": "#/$defs/AffinityConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "with_replacement": {
          "type": "boolean",
          "default": false
        },
        "max_attempts": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32",
          "default": null
        },
        "backoff": {
          "anyOf": [
            {
              "$ref": "#/$defs/Backoff"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_total_backoff_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32",
          "default": null
        }
      },
      "additionalProperties": false
    },
    "AffinityConfig": {
      "description": "Priority-only conversation affinity: the preferred provider keeps about\n`target_conversations` of the active conversations, decided per\nconversation rather than per request. Missing/null keeps per-request\nselection.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "target_conversations": {
          "description": "Conversations to keep on the preferred provider. Size it to the\npreferred provider's concurrency.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 0
        },
        "margin": {
          "description": "Drift allowed around the target before the share moves; defaults to a\ntenth of the target.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0,
          "default": null
        },
        "active_window_ms": {
          "description": "A conversation stays active this long after its last request.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 600000
        },
        "update_interval_ms": {
          "description": "The share is recomputed at multiples of this much wall-clock time.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 60000
        },
        "max_tracked": {
          "description": "Upper bound on conversations tracked per gateway process.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 100000
        }
      },
      "additionalProperties": false
    },
    "Backoff": {
      "type": "object",
      "properties": {
        "initial_ms": {
          "type": "integer",
          "format": "int32"
        },
        "max_ms": {
          "type": "integer",
          "format": "int32"
        },
        "factor": {
          "type": "number",
          "format": "double"
        },
        "jitter": {
          "$ref": "#/$defs/Jitter",
          "default": "full"
        }
      },
      "additionalProperties": false,
      "required": [
        "initial_ms",
        "max_ms",
        "factor"
      ]
    },
    "Jitter": {
      "type": "string",
      "enum": [
        "none",
        "full"
      ]
    },
    "Component": {
      "type": "object",
      "properties": {
        "deployment": {
          "type": "string"
        },
        "enabled": {
          "description": "Applied when the component is created. An existing component keeps its\nstored value.",
          "type": "boolean",
          "default": true
        },
        "weight": {
          "type": "integer",
          "format": "int32",
          "default": 1
        },
        "sort_order": {
          "type": "integer",
          "format": "int32",
          "default": 0
        },
        "strip_leading_bos": {
          "type": "boolean",
          "default": false
        },
        "render_kwargs": {
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "deployment"
      ]
    },
    "Tariff": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "purpose": {
          "$ref": "#/$defs/TariffPurpose"
        },
        "completion_window": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "input_per_million_tokens": {
          "type": "string"
        },
        "output_per_million_tokens": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "purpose",
        "input_per_million_tokens",
        "output_per_million_tokens"
      ]
    },
    "TariffPurpose": {
      "description": "Customer inference pricing is independent of internal key purposes.",
      "type": "string",
      "enum": [
        "realtime",
        "batch",
        "playground"
      ]
    },
    "CacheTariff": {
      "type": "object",
      "properties": {
        "write_multiplier_5m": {
          "type": "string"
        },
        "write_multiplier_1h": {
          "type": "string"
        },
        "write_multiplier_24h": {
          "type": "string"
        },
        "read_multiplier": {
          "type": "string",
          "default": "0.1"
        },
        "min_prefix_tokens": {
          "type": "integer",
          "format": "int32"
        }
      },
      "additionalProperties": false,
      "required": [
        "write_multiplier_5m",
        "write_multiplier_1h",
        "write_multiplier_24h",
        "min_prefix_tokens"
      ]
    },
    "TrafficRule": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "purpose": {
              "$ref": "#/$defs/Purpose"
            },
            "action": {
              "type": "string",
              "const": "deny"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "purpose"
          ]
        },
        {
          "type": "object",
          "properties": {
            "purpose": {
              "$ref": "#/$defs/Purpose"
            },
            "target": {
              "type": "string"
            },
            "action": {
              "type": "string",
              "const": "redirect"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "purpose",
            "target"
          ]
        }
      ]
    },
    "Purpose": {
      "type": "string",
      "enum": [
        "platform",
        "realtime",
        "batch",
        "playground",
        "continuation"
      ]
    },
    "RoutingMode": {
      "description": "How a virtual model routes its requests.",
      "oneOf": [
        {
          "description": "The model's composite routing (`routing`).",
          "type": "string",
          "const": "legacy"
        },
        {
          "description": "Each class in `class_routes` routes to its own upstream.",
          "type": "string",
          "const": "class_routes"
        }
      ]
    },
    "ClassRoute": {
      "description": "Complete catalog declaration for a stable class of the existing public model.",
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "upstream_model_name": {
          "type": "string"
        },
        "aliases": {
          "description": "Retired. Accepted only when empty: a class is reached only by the\nmodel's alias (`alias` or `alias:<class>`).",
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 0
        },
        "realtime_inflight_limit": {
          "description": "Concurrent realtime requests one account may have in flight on this\nclass. Omit for the model's `settings.realtime_inflight_limit`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int32",
          "minimum": 1
        },
        "tariffs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Tariff"
          }
        },
        "cache_tariff": {
          "description": "Omit to inherit the model's all-class multipliers; does not enable caching.",
          "anyOf": [
            {
              "$ref": "#/$defs/CachePrices"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "display_name",
        "endpoint",
        "upstream_model_name",
        "tariffs"
      ]
    },
    "CachePrices": {
      "description": "Scoped cache tariffs change multipliers only. The model owns enablement and\nthe minimum prefix length used by the classifier.",
      "type": "object",
      "properties": {
        "write_multiplier_5m": {
          "type": "string"
        },
        "write_multiplier_1h": {
          "type": "string"
        },
        "write_multiplier_24h": {
          "type": "string"
        },
        "read_multiplier": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "write_multiplier_5m",
        "write_multiplier_1h",
        "write_multiplier_24h",
        "read_multiplier"
      ]
    }
  }
}
